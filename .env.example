# LINE Bot 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Google Apps Script (書籤與歷史紀錄)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec

# Chat history
CHAT_HISTORY_LENGTH=5

# Image temp files
DOWNLOAD_IMAGE_DIR=pic

# Keepalive
KEEPALIVE_INTERVAL=780
SELF_URL=https://linebot-bisb.onrender.com/about

# Optional local LMStudio fallback
LMSTUDIO_URL=https://c8jkzw1b-3030.asse.devtunnels.ms/v1/chat/completions
LMSTUDIO_MODEL=llava-v1.5-7b

# SQLite database
DATABASE_PATH=data/chat_history.db

# API security key for database read/download endpoints
API_SECRET_KEY=change-me-to-a-long-random-secret
